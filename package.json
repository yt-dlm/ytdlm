{
  "name": "ytdlm",
  "version": "1.0.0",
  "description": "Real-time SABR UMP WebM/Opus audio streaming & seekable downloading library, CLI, and HTTP gateway for Discord music bots (Node.js, Python, Java, Rust).",
  "author": "ytdlm <341343882+ytdlm@users.noreply.github.com>",
  "homepage": "https://github.com/ytdlm/ytdlm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ytdlm/ytdlm.git"
  },
  "bugs": {
    "url": "https://github.com/ytdlm/ytdlm/issues"
  },
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "require": "./src/index.js"
    }
  },
  "bin": {
    "ytdlm": "bin/ytdlm.js"
  },
  "files": [
    "bin/",
    "src/",
    "sdks/",
    "LICENSE",
    "DISCLAIMER.md",
    "CONTRIBUTING.md",
    "README.md"
  ],
  "scripts": {
    "start": "node ./bin/ytdlm.js",
    "serve": "node ./bin/ytdlm.js serve",
    "test": "node ./test/verify.js"
  },
  "keywords": [
    "sabr",
    "ump",
    "opus",
    "webm",
    "audio-stream",
    "discord-bot",
    "discord-music",
    "lavaplayer",
    "ytdlm"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
